{
  "name": "keyloop-service-scheduler",
  "version": "1.0.0",
  "private": true,
  "description": "Keyloop Scenario A: a transactional service appointment scheduler",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "test:coverage": "npm run build && c8 --include='src/**' --exclude='src/server.ts' --exclude='src/seed.ts' tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@sinclair/typebox": "^0.34.52",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "c8": "^12.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
